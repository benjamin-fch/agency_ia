# ============================================================
# AGENCY IA — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# Ne jamais committer .env dans git
# ============================================================

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Notion (pour pipeline client)
NOTION_API_KEY=secret_...
NOTION_DATABASE_PROSPECTS=...       # ID de la base Prospects
NOTION_DATABASE_CLIENTS=...         # ID de la base Clients
NOTION_DATABASE_PROJETS=...         # ID de la base Projets

# Google (pour Drive/Docs livrables)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
GOOGLE_DRIVE_FOLDER_LIVRABLES=...   # ID du dossier Drive racine livrables

# n8n (si auto-hébergé, pour webhooks internes)
N8N_WEBHOOK_SECRET=...              # Secret pour sécuriser les webhooks n8n
N8N_BASE_URL=https://n8n.votredomaine.com

# Email sortant (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=...
SMTP_FROM=hello@votreagence.com

# GitHub (optionnel, pour versionner les livrables)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=...
GITHUB_REPO_NAME=agency-ia

# Site / Formulaire
CONTACT_FORM_WEBHOOK_URL=...        # URL webhook n8n pour formulaire de contact
AUDIT_FORM_WEBHOOK_URL=...          # URL webhook n8n pour formulaire audit

# Environnement
NODE_ENV=production
